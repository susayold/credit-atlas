  "analyst_finding": {
    "finding_id": "ABS-SURV-F001",
    "classification": "Source-definition and reconciliation exception",
    "status": "Open — root cause not established",
    "title": "ABS-EE recovery values do not reconcile uniformly to deal-certificate comparators",
    "statement": "Across the three deal contracts, deal-specific ABS-EE recovery comparisons produce 83 non-zero period residuals. Toyota's certificate comparator is aggregate net liquidation proceeds built from two signed components; Nissan's comparator is current recoveries of defaulted receivables. The dollar residuals and tie rates are therefore retained by deal and are not pooled. Available evidence does not identify whether remaining differences arise from population, cutoff, classification, correction, or servicing records.",
    "required_action": "Keep all residuals visible and request dated field/cutoff/reversal or transaction-mapping evidence before changing a reconciliation rule or using recovery amounts in LGD/cashflow analysis.",
    "use_limit": "Not a loss estimate, LGD, fraud signal, model validation result, accounting ECL, or evidence that any party reported incorrectly."
  }
